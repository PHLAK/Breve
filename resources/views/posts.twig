{% extends "layouts/app.twig" %}
{% set title = 'All Posts' %}

{% block content %}
    <div id="posts-list" class="grow space-y-8 my-12">
        <h1 class="text-2xl font-light text-center md:text-4xl dark:text-stone-200">
            All Posts
        </h1>

        <div class="space-y-10">
            {% for year, yearPosts in posts %}
                <section>
                    <h2 class="flex items-center gap-4 mb-2">
                        <span class="font-mono font-semibold tracking-widest text-stone-400 dark:text-stone-500">{{ year }}</span>
                        <span class="grow border-t-2 border-stone-300 dark:border-stone-600"></span>
                    </h2>

                    <ul class="divide-y divide-stone-200/70 dark:divide-stone-700/70">
                        {% for slug, post in yearPosts %}
                            <li>
                                <a href="{{ url_for('post', { slug: slug }) }}" class="group flex flex-col gap-1 px-2 py-2 hover:bg-stone-200/60 dark:hover:bg-stone-700/60 sm:flex-row sm:items-baseline sm:gap-4">
                                    <time datetime="{{ post.published.format('c') }}" class="shrink-0 font-mono text-sm text-stone-400 dark:text-stone-500 sm:w-16">
                                        {{ post.published.format('M j') }}
                                    </time>

                                    <span class="grow font-medium text-stone-600 group-hover:underline dark:text-stone-400">{{ post.title }}</span>

                                    {% if post.tags %}
                                        <span class="hidden shrink-0 text-xs text-stone-400 dark:text-stone-600 md:block">
                                            {{ post.tags | join(' • ') }}
                                        </span>
                                    {% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}
        </div>
    </div>
{% endblock %}
