{
    "name": "phlak/breve",
    "description": "Self-hosted, markdown powered, flat-file blogging platform",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Kankiewicz",
            "email": "Chris@Kankiewicz.com"
        }
    ],
    "support": {
        "issues": "https://github.com/PHLAK/Breve/issues"
    },
    "require": {
        "php": ">= 8.4",
        "filp/whoops": "^2.18",
        "illuminate/collections": "^13.1",
        "league/commonmark": "^2.7",
        "nesbot/carbon": "^3.10",
        "phlak/commonmark-rewrite-local-image-urls": "^1.0",
        "php-di/php-di": "^7.1",
        "php-di/slim-bridge": "^3.4",
        "pomodocs/commonmark-alert": "^0.8.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.15",
        "slim/twig-view": "^3.4",
        "spatie/async": "^1.8",
        "spatie/commonmark-shiki-highlighter": "^2.5",
        "symfony/cache": "^8.0",
        "symfony/console": "^8.0",
        "symfony/yaml": "^8.0",
        "twig/html-extra": "^3.21",
        "vlucas/phpdotenv": "^5.6",
        "webmozart/assert": "^2.1",
        "yetidevworks/yetisearch": "^2.3"
    },
    "require-dev": {
        "phlak/coding-standards": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "symfony/var-dumper": "^8.0",
        "zorac/phpstan-php-di": "^1.0"
    },
    "suggest": {
        "ext-apcu": "Required to use the APCu cache driver",
        "ext-memcached": "Required to use the Memcached driver",
        "ext-redis": "Required to use the Redis cache driver"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "serve": "php --server localhost:8080 --docroot public",
        "post-create-project-cmd": [
            "npm install && npm run dev",
            "cp .env.example .env"
        ]
    }
}
